{
  "name": "myapp",
  "version": "0.1.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "dev:tauri": "node scripts/dev-tauri.mjs",
    "dev:web": "vite --config apps/desktop/vite.config.ts --port 5173 --mode web",
    "typecheck": "vue-tsc --noEmit --project apps/desktop/tsconfig.json",
    "build": "vite build --config apps/desktop/vite.config.ts",
    "build:checked": "pnpm typecheck && pnpm build",
    "check": "node scripts/run-check.mjs",
    "preview": "vite preview --config apps/desktop/vite.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fmt:rs": "cargo fmt -p myapp -p app-core -p app-platform -p app-mcp",
    "fmt:rs:check": "cargo fmt -p myapp -p app-core -p app-platform -p app-mcp -- --check",
    "sync-version": "node scripts/sync-version.mjs",
    "tauri": "tauri",
    "release": "node scripts/release.mjs",
    "test": "node --test scripts/test/foundation.test.mjs",
    "check:public": "node scripts/check-public-files.mjs",
    "check:identity": "node scripts/check-app-config.mjs",
    "validate": "pnpm sync-version --check && pnpm check:identity && pnpm check:public && pnpm lint && pnpm format:check && pnpm fmt:rs:check && pnpm test && pnpm build:checked && cargo test --workspace --lib --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-updater": "2.10.1",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.20.0"
}
