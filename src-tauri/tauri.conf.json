{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyApp",
  "version": "0.1.5",
  "identifier": "com.myapp.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm check:identity && pnpm build:checked"
  },
  "app": {
    "windows": [
      {
        "title": "MyApp",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "desktopTemplate": "linux/MyApp.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/MyApp.desktop"
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "TradChinese"],
        "template": "windows/nsis/installer.nsi"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["myapp"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCNzg0MENDQ0QxNDQ5MTUKUldRVlNSVE56RUI0aTJpSUc4VGwzL2drMDFIbjl2YWxRMlNtd281bVk0QWRlM1FUZWdVdXk3Y28K",
      "endpoints": ["https://github.com/liuzheng110/yy_desk/releases/latest/download/latest.json"]
    }
  }
}
